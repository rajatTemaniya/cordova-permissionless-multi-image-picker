<?xml version="1.0" encoding="UTF-8"?>
<plugin id="cordova-permissionless-multi-image-picker"
        version="1.0.0"
        xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">

    <name>Cordova Permissionless Multi Image Picker</name>
    <description>
        Pick multiple images natively on Android and iOS without requesting
        media permissions. Returns file:// URIs ready for use with cordova-plugin-file.
    </description>
    <author>Rajat Temaniya</author>
    <license>MIT</license>
    <keywords>cordova, photo, picker, image, permissionless, multi, android, ios</keywords>

    <engines>
        <engine name="cordova-android" version=">=10.0.0" />
        <engine name="cordova-ios"     version=">=6.0.0"  />
    </engines>

    <js-module name="PermissionlessMultiImagePicker"
               src="www/cordova-permissionless-multi-image-picker.js">
        <clobbers target="cordova.plugins.PermissionlessMultiImagePicker" />
    </js-module>

    <!-- ═══════════════════════════ ANDROID ═══════════════════════════ -->
    <platform name="android">

        <source-file
            src="src/android/multiimagepicker/PermissionlessMultiImagePicker.java"
            target-dir="app/src/main/java/multiimagepicker" />

        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="PermissionlessMultiImagePicker">
                <param name="android-package"
                       value="multiimagepicker.PermissionlessMultiImagePicker" />
            </feature>
        </config-file>

        <!-- No permissions declared — that's the whole point of this plugin -->

    </platform>

    <!-- ════════════════════════════ iOS ══════════════════════════════ -->
    <platform name="ios">

        <source-file src="src/ios/PermissionlessMultiImagePicker.m" />

        <config-file target="config.xml" parent="/*">
            <feature name="PermissionlessMultiImagePicker">
                <param name="ios-package" value="PermissionlessMultiImagePicker" />
            </feature>
        </config-file>

        <!-- PHPickerViewController requires no NSPhotoLibraryUsageDescription -->

    </platform>

</plugin>